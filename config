ngx_addon_name=ngx_var_module

# Check for cJSON library
ngx_feature="cJSON library"
ngx_feature_name="NGX_CJSON"
ngx_feature_run=no
ngx_feature_incs="#include <cjson/cJSON.h>"
ngx_feature_path=
ngx_feature_libs="-lcjson"
ngx_feature_test="cJSON *json = cJSON_Parse(\"{}\");
                  if (json) {
                      (void) cJSON_GetObjectItemCaseSensitive(json, \"key\");
                      cJSON_Delete(json);
                  }"
. auto/feature

if [ "$ngx_found" = yes ]; then
    ngx_var_cjson_libs="$ngx_feature_libs"
else
    ngx_var_cjson_libs=

    cat << END

$0: warning: cJSON library not found, extract_json operation will not be available

END
fi

if [ "$HTTP" = YES ]; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_var_module
    ngx_module_srcs="$ngx_addon_dir/ngx_http_var_module.c"
    ngx_module_libs="$ngx_var_cjson_libs"

    . auto/module
fi

if [ "$STREAM" = YES ]; then
    ngx_module_type=STREAM
    ngx_module_name=ngx_stream_var_module
    ngx_module_srcs="$ngx_addon_dir/ngx_stream_var_module.c"
    ngx_module_libs="$ngx_var_cjson_libs"

    . auto/module
fi
